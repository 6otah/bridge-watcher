# Copy to .env and fill in what you need. Never commit .env.
# Leave a variable commented out to leave it unset: an empty value is not the
# same as unset for every consumer.

# Config path (default: bridge-watcher.toml).
# BW_CONFIG=
# RPC URL overrides. A URL with an API key is a secret.
# BW_EVM_RPC_URL=
# BW_SOLANA_RPC_URL=
# Set both to enable Telegram alerts; leave both unset for log-only.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Log filter (default: info).
# RUST_LOG=
